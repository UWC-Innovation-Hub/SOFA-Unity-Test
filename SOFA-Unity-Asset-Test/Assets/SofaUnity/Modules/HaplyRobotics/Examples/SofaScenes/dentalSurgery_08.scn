<!--
Using LCP contact detection and resolution:
 + Added a driver for the Omni phantom device
 + Added a mechanical state controller that gathers data from the phantom and updates the position of a representation of the device in the simulation
 + Added a computation (LCPForceFeedback) of the haptic forces
 + Added VectorSpringForceField && JointSpringForceField to link the movements of the Omni phantom and the instrument
-->
<Node name="root" dt="0.005">
    <RequiredPlugin name="SofaOpenglVisual"/>
    <BackgroundSetting color="0.901960784 0.925490196 0.964705882" />
    <RequiredPlugin name="Sensable plugin" pluginName="Sensable" />

    <Gravity name="G" gravity="0 -9.8 0" />
    <CollisionPipeline name="pipeline" depth="6" verbose="0" />
    <BruteForceBroadPhase/>
    <BVHNarrowPhase/>
    <CollisionResponse name="response" response="FrictionContactConstraint" />
    <LocalMinDistance name="proximity" alarmDistance="0.3" contactDistance="0.15" angleCone="0.0" />
    <FreeMotionAnimationLoop />
    <LCPConstraintSolver tolerance="0.001" maxIt="1000"/>
    <Node name="Head">
        <MeshOBJLoader name="meshLoader_2" filename="./mesh/head.obj" handleSeams="1" />
        <OglModel name="HeadVisualModel" src="@meshLoader_2" texturename="./mesh/head_baseTexBaked.png" />
        <Node name="input-tongue">
            <MeshTopology name="surface" filename="./mesh/tongue.obj" />
            <MeshTetraStuffing name="stuffing" snapPoints="true" splitTetras="true" draw="true" size="0.2" alphaLong="0.2" alphaShort="0.4" inputPoints="@surface.position" inputTriangles="@surface.triangles" inputQuads="@surface.quads"  />
            <OglModel name="VisualModel" src="@surface" color="1.0 0.0 0.0 1.0" />
        </Node>

        <Node name="Tongue">
            <VisualStyle displayFlags="showForceFields" />
            <EulerImplicitSolver name="odesolver" />
            <CGLinearSolver iterations="10" name="linear solver" tolerance="1.0e-9" threshold="1.0e-9" />
            <TetrahedronSetTopologyContainer name="volume" points="@../input-tongue/stuffing.outputPoints" tetras="@../input-tongue/stuffing.outputTetras" />
            <TetrahedronSetGeometryAlgorithms name="GeomAlgo" />
            <MechanicalObject name="mecaTongue" />
            <DiagonalMass massDensity="1" name="computed using mass density" />
            <TetrahedralCorotationalFEMForceField name="FEM" youngModulus="3000" poissonRatio="0.45" method="large" />
            <Node name="TongueVisualModel">
                <MeshOBJLoader name="meshLoader_3" filename="./mesh/tongue.obj" handleSeams="1" />
                <OglModel name="TongueVisualModel" src="@meshLoader_3" texturename="./mesh/tongue_color.png" />
                <BarycentricMapping name="tongueMapping" input="@../mecaTongue" output="@TongueVisualModel" />
            </Node>
            <Node name="TongueCollisionModel">
                <TriangleSetTopologyContainer name="TriContainer" />
                <TriangleSetTopologyModifier name="Modifier" />
                <TriangleSetGeometryAlgorithms name="GeomAlgo" />
                <Tetra2TriangleTopologicalMapping name="mapping" input="@../volume" output="@TriContainer" flipNormals="0" />
                <MechanicalObject name="colTongue" />
                <TriangleCollisionModel name="tongue" />
                <IdentityMapping name="identityMappingToCollision" input="@../mecaTongue" output="@colTongue" isMechanical="false" />
            </Node>
        </Node>
        <Node name="Teeth">
            <MeshOBJLoader filename="./mesh/teeth.obj" name="loader" />
            <Node name="CollisionModel">
                <MeshTopology src="@../loader" name="ToothCollisionModel" />
                <MechanicalObject src="@../loader" name="toothState" />
                <TriangleCollisionModel name="tooth" contactStiffness="5" simulated="0" moving="0" />
                <LineCollisionModel name="tooth" contactStiffness="5" simulated="0" moving="0" />
                <PointCollisionModel name="tooth" contactStiffness="5" simulated="0" moving="0" />
            </Node>
            <Node name="VisualModel">
                <MeshOBJLoader name="meshLoader_0" filename="./mesh/teeth.obj" handleSeams="1" />
                <OglModel name="TeethVisualModel" src="@meshLoader_0" texturename="./mesh/teeth_color.png" />
            </Node>
        </Node>
    </Node>

    <Node name="Instrument" >
        <EulerImplicitSolver name="ODE solver" rayleighStiffness="0.01" rayleighMass="0.1" />
        <SparseLDLSolver template="CompressedRowSparseMatrixMat3x3d"/>

		<MechanicalObject name="instrumentState" template="Rigid3" />
		<UniformMass name="mass" totalMass="1.0" />

		<RestShapeSpringsForceField stiffness='1000000' angularStiffness='1000000' external_rest_shape='@../HaplyMO' points='0' external_points='0'/>
        <LCPForceFeedback name="LCPFF1" activate="true" forceCoef="0.0005" />
        <LinearSolverConstraintCorrection />

		<Node name="VisuTool" >
            <MeshOBJLoader name="meshLoader_1" filename="./mesh/dental_instrument.obj" handleSeams="1"
                rotation="-90 -90 0" translation="0 -3.5 0.3"/>
            <OglModel name="InstrumentVisualModel" src="@meshLoader_1" color="1.0 0.2 0.2 1.0" />
            <RigidMapping name="MM->VM mapping" input="@instrumentState" output="@InstrumentVisualModel" />
        </Node>

        <Node name="CollisionModel" >
            <MeshOBJLoader name="loader" filename="./mesh/dental_instrument_centerline.obj"
                rotation="@../VisuTool/meshLoader_1.rotation" translation="@../VisuTool/meshLoader_1.translation"/>
            <MeshTopology src="@loader" name="InstrumentCollisionModel" />
            <MechanicalObject src="@loader" name="instrumentCollisionState" />
            <LineCollisionModel />
            <PointCollisionModel />
            <RigidMapping name="MM->CM mapping" input="@instrumentState" output="@instrumentCollisionState" />
        </Node>
    </Node>
    </Node>
</Node>
